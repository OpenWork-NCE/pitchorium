{
  "name": "@pitchorium/i18n",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./locales/*.json": "./dist/locales/*.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "lint": "eslint .",
    "check:keys": "node --import tsx scripts/check-keys.ts"
  },
  "devDependencies": {
    "@pitchorium/config": "workspace:*",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@pitchorium/contracts": "workspace:*"
  }
}
