    "react-dom": "19.3.0",
    "react-email": "6.11.1"
  },
  "devDependencies": {
    "@pitchorium/config": "workspace:*",
    "@react-email/ui": "6.11.1",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
