{
  "name": "pitchorium",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": "12.9.1"
  },
  "scripts": {
    "dev": "turbo run dev:api dev:worker",
    "dev:api": "turbo run dev:api",
    "dev:worker": "turbo run dev:worker",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @pitchorium/db db:generate",
    "db:migrate": "pnpm --filter @pitchorium/db db:migrate",
    "db:seed": "pnpm --filter @pitchorium/db db:seed",
    "db:seed:dev": "turbo run db:seed:dev --filter=@pitchorium/server",
    "db:check": "pnpm --filter @pitchorium/db db:check",
    "admin:create": "pnpm --filter @pitchorium/server admin:create",
    "i18n:check": "turbo run check:keys",
    "openapi:generate": "turbo run openapi:generate",
    "api-client:generate": "turbo run api-client:generate",
    "infra:up": "docker compose -f infra/docker/compose.yaml up -d --wait postgres valkey minio mailpit clamav && docker compose -f infra/docker/compose.yaml run --rm minio-init",
    "infra:down": "docker compose -f infra/docker/compose.yaml down",
    "check:box-drawing": "sh scripts/check-box-drawing.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@pitchorium/config": "workspace:*",
    "eslint": "10.12.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "turbo": "2.11.7"
  },
  "type": "module",
  "prettier": "@pitchorium/config/prettier",
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": "prettier --write"
  }
}
