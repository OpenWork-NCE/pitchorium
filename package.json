{
  "name": "pitchorium",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": "12.9.1"
  },
  "scripts": {
    "dev": "turbo run dev:api dev:worker dev:web",
    "dev:api": "turbo run dev:api",
    "dev:worker": "turbo run dev:worker",
    "dev:web": "turbo run dev:web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:providers": "turbo run test:providers",
    "test:e2e": "turbo run test:e2e",
    "providers:stripe-test-account": "pnpm --filter @pitchorium/server providers:stripe-test-account",
    "providers:cleanup": "pnpm --filter @pitchorium/server providers:cleanup",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @pitchorium/db db:generate",
    "db:migrate": "pnpm --filter @pitchorium/db db:migrate",
    "db:seed": "pnpm --filter @pitchorium/db db:seed",
    "db:seed:dev": "turbo run db:seed:dev --filter=@pitchorium/server",
    "db:check": "pnpm --filter @pitchorium/db db:check",
    "admin:create": "pnpm --filter @pitchorium/server admin:create",
    "payments:reconcile": "pnpm --filter @pitchorium/server payments:reconcile",
    "discovery:reindex": "pnpm --filter @pitchorium/server discovery:reindex",
    "i18n:check": "turbo run check:keys",
    "openapi:generate": "turbo run openapi:generate",
    "api-client:generate": "turbo run api-client:generate",
    "infra:up": "docker compose -f infra/docker/compose.yaml up -d --wait postgres valkey minio mailpit clamav && docker compose -f infra/docker/compose.yaml run --rm minio-init",
    "infra:down": "docker compose -f infra/docker/compose.yaml down",
    "docs:api": "node scripts/serve-api-docs.mjs",
    "perf:load": "docker run --rm --network host -v ./perf/k6:/scripts -e API_URL -e RATE_FACTOR -e DURATION grafana/k6:2.2.0 run /scripts/scenarios.js",
    "ops:restore-drill": "bash scripts/restore-drill.sh",
    "check:dead-code": "pnpm dlx knip@6.38.0 --no-progress",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:box-drawing": "sh scripts/check-box-drawing.sh",
    "check:changed": "sh scripts/check-changed.sh",
    "brand:sync": "pnpm --filter @pitchorium/web brand:sync",
    "storybook": "pnpm --filter @pitchorium/web storybook",
    "verify:clean": "bash scripts/verify-clean.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@pitchorium/config": "workspace:*",
    "eslint": "10.12.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "turbo": "2.11.7"
  },
  "type": "module",
  "prettier": "@pitchorium/config/prettier",
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": "prettier --write"
  }
}
