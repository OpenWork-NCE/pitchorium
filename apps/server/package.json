{
  "name": "@pitchorium/server",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "test:integration": "vitest run -c vitest.integration.config.mts",
    "dev:api": "node --env-file-if-exists=.env --watch -r @swc-node/register src/main.api.ts",
    "dev:worker": "node --env-file-if-exists=.env --watch -r @swc-node/register src/main.worker.ts",
    "start:api": "node dist/main.api.js",
    "start:worker": "node dist/main.worker.js",
    "openapi:generate": "node dist/main.openapi.js",
    "outbox:ping": "node --env-file-if-exists=.env --import tsx scripts/emit-ping-event.mts",
    "admin:create": "node --env-file-if-exists=.env -r @swc-node/register src/main.create-admin.ts",
    "payments:reconcile": "node --env-file-if-exists=.env -r @swc-node/register src/main.reconcile.ts",
    "db:seed:dev": "node --env-file-if-exists=.env -r @swc-node/register scripts/seed-dev.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1147.0",
    "@aws-sdk/s3-request-presigner": "3.1147.0",
    "@napi-rs/canvas": "1.0.10",
    "@nest-lab/throttler-storage-redis": "1.2.0",
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/platform-socket.io": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/websockets": "11.2.7",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/instrumentation-express": "0.71.0",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/instrumentation-ioredis": "0.71.0",
    "@opentelemetry/instrumentation-nestjs-core": "0.69.0",
    "@opentelemetry/instrumentation-pg": "0.75.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@pitchorium/contracts": "workspace:*",
    "@pitchorium/db": "workspace:*",
    "@pitchorium/emails": "workspace:*",
    "@pitchorium/i18n": "workspace:*",
    "@sentry/node": "11.5.0",
    "@socket.io/redis-adapter": "8.3.0",
    "better-auth": "1.7.7",
    "better-call": "1.4.0",
    "bullmq": "6.3.11",
    "bullmq-otel": "2.0.1",
    "file-type": "22.1.1",
    "franc-min": "6.2.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.3.1",
    "nestjs-zod": "5.5.0",
    "nodemailer": "10.0.15",
    "pdfjs-dist": "6.4.299",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "resend": "6.32.1",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "socket.io": "4.8.4",
    "uuid": "14.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@pitchorium/config": "workspace:*",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.13",
    "@testcontainers/postgresql": "12.2.0",
    "@testcontainers/redis": "12.2.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "pino-pretty": "13.2.0",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.1",
    "testcontainers": "12.2.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.3"
  }
}
