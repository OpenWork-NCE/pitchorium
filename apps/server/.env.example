# Copy to .env for local development. Values below match infra/docker/compose.yaml.
# Empty values are treated as unset. Never commit a real secret.

# Shared by the api and the worker

# development | test | production (production disables Swagger UI)
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

DATABASE_URL=postgres://pitchorium:pitchorium@localhost:5432/pitchorium
# Connections per process.
DATABASE_POOL_MAX=10

# rediss:// for TLS.
REDIS_URL=redis://localhost:6379
# Redis key prefix of the BullMQ queues.
QUEUE_PREFIX=pitchorium

# S3-compatible storage: MinIO locally, Cloudflare R2 in production
# (S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com, S3_REGION=auto, S3_FORCE_PATH_STYLE=false).
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=pitchorium
S3_SECRET_ACCESS_KEY=pitchorium-secret
S3_FORCE_PATH_STYLE=true
S3_BUCKET_PUBLIC=pitchorium-public
S3_BUCKET_PRIVATE=pitchorium-private
# Base URL of public objects (R2 custom domain in production).
S3_PUBLIC_BASE_URL=http://localhost:9000/pitchorium-public

# smtp (Mailpit locally) | resend (production)
MAIL_TRANSPORT=smtp
MAIL_FROM=Pitchorium <no-reply@pitchorium.local>
# Required when MAIL_TRANSPORT=smtp.
SMTP_URL=smtp://localhost:1025
# Required when MAIL_TRANSPORT=resend.
RESEND_API_KEY=

# Error reporting is enabled only when a DSN is set.
SENTRY_DSN=
# Defaults to NODE_ENV.
SENTRY_ENVIRONMENT=

# Tracing is enabled only when an OTLP/HTTP endpoint is set (for example http://localhost:4318).
OTEL_EXPORTER_OTLP_ENDPOINT=
# Defaults to pitchorium-api or pitchorium-worker.
OTEL_SERVICE_NAME=

# Origin of the web application, used in the links sent by email and as an auth redirect target.
WEB_APP_URL=http://localhost:5173

# Versions in force of the terms of service and the privacy policy. Changing one asks every
# member to accept the new version (identifiers: letters, digits, dot, underscore, hyphen).
LEGAL_TERMS_VERSION=draft-2026-10
LEGAL_PRIVACY_VERSION=draft-2026-10

# api only

API_HOST=0.0.0.0
API_PORT=3000
# Public origin of the api as seen by browsers and OAuth providers. https:// enables Secure cookies.
API_PUBLIC_URL=http://localhost:3000
# Comma-separated list of allowed browser origins. Empty disables CORS.
CORS_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the api (client IP for rate limiting).
TRUST_PROXY_HOPS=0
# Requests allowed per client IP and per window.
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120
# Retention of Idempotency-Key responses.
IDEMPOTENCY_TTL_HOURS=24

# Authentication (Better Auth, mounted on /v1/auth)

# At least 32 random characters (openssl rand -base64 32). The value below is for local use only.
AUTH_SECRET=local-development-secret-not-for-production-use
# Origins allowed to send cookie-authenticated writes. Empty means CORS_ORIGINS.
AUTH_TRUSTED_ORIGINS=
# Parent domain shared by the web app and the api (for example pitchorium.com). Empty: host-only.
AUTH_COOKIE_DOMAIN=
# Stricter limit per client IP on sign-in, sign-up, magic link, password reset and 2FA checks.
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=10
# Rejects passwords found in Have I Been Pwned (k-anonymity: only 5 hash characters are sent).
AUTH_PWNED_PASSWORD_CHECK=true
# OAuth providers are enabled only when both values are set. Redirect URI to register:
# <API_PUBLIC_URL>/v1/auth/callback/<google|linkedin|microsoft>.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# LinkedIn: "Sign In with LinkedIn using OpenID Connect" product.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Microsoft Entra ID, multi-tenant application (personal and work accounts, tenant "common").
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# worker only

# Port of the worker liveness and readiness probe.
WORKER_HEALTH_PORT=3001
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
# Upper bound of the exponential backoff after a failed publication.
OUTBOX_MAX_BACKOFF_MS=300000
