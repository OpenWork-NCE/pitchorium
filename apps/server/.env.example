# Copy to .env for local development. Values below match infra/docker/compose.yaml.
# Empty values are treated as unset. Never commit a real secret.

# Shared by the api and the worker

# development | test | production (production disables Swagger UI)
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

DATABASE_URL=postgres://pitchorium:pitchorium@localhost:5432/pitchorium
# Connections per process.
DATABASE_POOL_MAX=10

# rediss:// for TLS.
REDIS_URL=redis://localhost:6379
# Redis key prefix of the BullMQ queues.
QUEUE_PREFIX=pitchorium

# S3-compatible storage: MinIO locally, Cloudflare R2 in production
# (S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com, S3_REGION=auto, S3_FORCE_PATH_STYLE=false).
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=pitchorium
S3_SECRET_ACCESS_KEY=pitchorium-secret
S3_FORCE_PATH_STYLE=true
S3_BUCKET_PUBLIC=pitchorium-public
S3_BUCKET_PRIVATE=pitchorium-private
# Base URL of public objects (R2 custom domain in production).
S3_PUBLIC_BASE_URL=http://localhost:9000/pitchorium-public

# smtp (Mailpit locally) | resend (production)
MAIL_TRANSPORT=smtp
MAIL_FROM=Pitchorium <no-reply@pitchorium.local>
# Required when MAIL_TRANSPORT=smtp.
SMTP_URL=smtp://localhost:1025
# Required when MAIL_TRANSPORT=resend.
RESEND_API_KEY=

# Error reporting is enabled only when a DSN is set.
SENTRY_DSN=
# Defaults to NODE_ENV.
SENTRY_ENVIRONMENT=

# Traces and metrics are exported only when an OTLP/HTTP endpoint is set (for example
# http://localhost:4318).
OTEL_EXPORTER_OTLP_ENDPOINT=
# Defaults to pitchorium-api or pitchorium-worker.
OTEL_SERVICE_NAME=

# Origin of the web application, used in the links sent by email and as an auth redirect target.
WEB_APP_URL=http://localhost:5173

# Versions in force of the terms of service and the privacy policy. Changing one asks every
# member to accept the new version (identifiers: letters, digits, dot, underscore, hyphen).
LEGAL_TERMS_VERSION=draft-2026-10
LEGAL_PRIVACY_VERSION=draft-2026-10

# Days of profile views kept; older views are purged by a scheduled task. Provisional.
NETWORK_PROFILE_VIEWS_RETENTION_DAYS=90

# Payments (section 9, docs/architecture/payments.md)

# simulated: the simulated provider alone (development, tests); refused when NODE_ENV=production.
# live: Stripe Connect and Flutterwave, each enabled when both its values below are set.
PAYMENTS_MODE=simulated
# Stripe test keys: Dashboard > Developers > API keys (sk_test_...) and the signing secret of the
# webhook endpoint listening to connected accounts (whsec_...), URL <API_PUBLIC_URL>/v1/payments/webhooks/stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Overridden only by the tests (fake server).
STRIPE_API_BASE_URL=https://api.stripe.com
# Flutterwave v3 test keys: Dashboard > Settings > API keys (FLWSECK_TEST-...) and the secret hash of
# Settings > Webhooks (sent in verif-hash), URL <API_PUBLIC_URL>/v1/payments/webhooks/flutterwave.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
FLUTTERWAVE_API_BASE_URL=https://api.flutterwave.com
# Signs the notifications of the simulated provider (development value only).
PAYMENTS_SIMULATED_WEBHOOK_SECRET=simulated-webhook-secret-for-development-only
# Commission in basis points (500 = 5 %) and its version, recorded on each contribution.
PAYMENTS_COMMISSION_RATE_BPS=500
PAYMENTS_COMMISSION_VERSION=2026-10
# Lifetime of a payment session and of its reward reservation (30 to 1440 minutes).
PAYMENTS_SESSION_TTL_MINUTES=60
# Provisional values, see docs/open-questions.md: bounds of a contribution on its EUR equivalent
# (cents), contributions per hour and per contributor, sessions per hour and per method, EUR
# equivalent (cents) above which two-factor authentication is required, anonymous donations.
PAYMENTS_MIN_EUR_MINOR=100
PAYMENTS_MAX_EUR_MINOR=1000000
PAYMENTS_CONTRIBUTIONS_PER_HOUR=10
PAYMENTS_SESSIONS_PER_METHOD_PER_HOUR=5
PAYMENTS_ENHANCED_VERIFICATION_EUR_MINOR=100000
PAYMENTS_ANONYMOUS_DONATIONS=false

# Public origin of the api as seen by browsers, OAuth providers and email clients (one-click
# unsubscribe). https:// enables Secure cookies.
API_PUBLIC_URL=http://localhost:3000
# Signs the links of the emails (unsubscribe), 32 characters or more; the development default
# is refused when NODE_ENV=production.
EMAIL_LINK_SECRET=

# Messaging and notifications, provisional values (docs/open-questions.md).
# Who may write to a member out of network by default: connections_only,
# connections_and_second_degree or verified_members.
MESSAGING_DEFAULT_POLICY=connections_and_second_degree
# A message can be edited during this delay after it was sent.
MESSAGING_EDIT_WINDOW_MINUTES=15
# Events on the same target within this window join one notification (« Amina et 12 autres »).
NOTIFICATIONS_AGGREGATION_WINDOW_MINUTES=1440
# Low-priority notifications (posts of the members followed) created per member and day.
NOTIFICATIONS_LOW_PRIORITY_PER_DAY=20

# api only

API_HOST=0.0.0.0
API_PORT=3000
# Comma-separated list of allowed browser origins. Empty disables CORS.
CORS_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the api (client IP for rate limiting).
TRUST_PROXY_HOPS=0
# Requests allowed per client IP and per window.
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120
# Retention of Idempotency-Key responses.
IDEMPOTENCY_TTL_HOURS=24
# First messages out of network a member may send in 24 hours (provisional).
MESSAGING_REQUESTS_PER_DAY=20
# Signing secret (whsec_...) of the Resend webhook endpoint <API_PUBLIC_URL>/v1/notifications/
# webhooks/resend (bounces and complaints, docs/architecture/email-deliverability.md).
RESEND_WEBHOOK_SECRET=

# Media (direct upload to the private bucket, then checks by the worker)

# Validity of the presigned upload URL and of the read URL of a private file.
MEDIA_UPLOAD_URL_TTL_SECONDS=900
MEDIA_DOWNLOAD_URL_TTL_SECONDS=300
# Per member quota (files not deleted). Provisional values, see docs/open-questions.md.
MEDIA_QUOTA_MAX_FILES=500
MEDIA_QUOTA_MAX_BYTES=1073741824
MEDIA_UPLOAD_REQUESTS_PER_HOUR=60

# Network (anti-abuse values are provisional, see docs/open-questions.md)

# Connection requests a member may send per rolling week.
NETWORK_CONNECTION_REQUESTS_PER_WEEK=100
# Days before a member may ask again someone who declined their request.
NETWORK_DECLINE_COOLDOWN_DAYS=21
# Days after which a pending connection request expires.
NETWORK_REQUEST_TTL_DAYS=30
# Mutual connections are counted up to this value, then shown as "999+".
NETWORK_MUTUAL_CONNECTIONS_CAP=999

# Content

# Below this number of network publications, the feed is completed by editorial highlights.
# Provisional, see docs/open-questions.md.
CONTENT_FEED_EDITORIAL_THRESHOLD=10

# Organizations

# Organizations a member may create (not deleted). Provisional, see docs/open-questions.md.
ORGANIZATIONS_MAX_CREATED_PER_USER=5
ORGANIZATIONS_INVITATION_TTL_DAYS=7
# Comma-separated criteria codes a verification decision may tick (lowercase, digits, _).
# Empty until the criteria are defined (docs/open-questions.md).
ORGANIZATIONS_VERIFICATION_CRITERIA=

# Authentication (Better Auth, mounted on /v1/auth)

# At least 32 random characters (openssl rand -base64 32). The value below is for local use only.
AUTH_SECRET=local-development-secret-not-for-production-use
# Origins allowed to send cookie-authenticated writes. Empty means CORS_ORIGINS.
AUTH_TRUSTED_ORIGINS=
# Parent domain shared by the web app and the api (for example pitchorium.com). Empty: host-only.
AUTH_COOKIE_DOMAIN=
# Stricter limit per client IP on sign-in, sign-up, magic link, password reset and 2FA checks.
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=10
# Rejects passwords found in Have I Been Pwned (k-anonymity: only 5 hash characters are sent).
# Fails open: when the service is down, slow (3 s) or in error, the password is accepted.
AUTH_PWNED_PASSWORD_CHECK=true
# OAuth providers are enabled only when both values are set. Redirect URI to register:
# <API_PUBLIC_URL>/v1/auth/callback/<google|linkedin|microsoft>.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# LinkedIn: "Sign In with LinkedIn using OpenID Connect" product.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Microsoft Entra ID, multi-tenant application (personal and work accounts, tenant "common").
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# worker only

# Port of the worker liveness and readiness probe.
WORKER_HEALTH_PORT=3001
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
# Upper bound of the exponential backoff after a failed publication.
OUTBOX_MAX_BACKOFF_MS=300000
# Antivirus (clamd, INSTREAM over TCP).
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=60000
# Files neither attached nor deleted after this delay are deleted by a scheduled task.
MEDIA_ORPHAN_TTL_HOURS=24
# Download of OAuth provider photos and of link preview images.
MEDIA_IMPORT_TIMEOUT_MS=10000
# Replaces the cron pattern of every scheduled task by a fixed interval, in milliseconds.
# Tests and local debugging only; refused when NODE_ENV=production.
SCHEDULED_TASKS_EVERY_MS=
# Link previews: fetch of the linked page (SSRF-protected client, ADR 0033).
CONTENT_LINK_PREVIEW_TIMEOUT_MS=5000
CONTENT_LINK_PREVIEW_MAX_BYTES=1048576
# Purge of the CDN in front of the public bucket when a file becomes private or is deleted
# (ADR 0026): none (local, tests) or cloudflare. Required in production.
CDN_PURGE_PROVIDER=none
# Zone of the custom domain of the public bucket, and an API token restricted to that zone with
# the « Zone > Cache Purge > Purge » permission only (docs/architecture/storage.md).
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
# Projects: a campaign ending within this delay is announced as ending soon (provisional value,
# docs/open-questions.md).
PROJECTS_ENDING_SOON_HOURS=72
# Days of provider transactions compared with the ledger by the daily reconciliation.
PAYMENTS_RECONCILIATION_LOOKBACK_DAYS=3
# Notifications, provisional values (docs/open-questions.md): purge after this many days,
# recipients per batch (one job creates them, one job pushes and emails them, ADR 0064), delay
# before the email of an unread message, local hour of the digests in the time zone of each member.
NOTIFICATIONS_RETENTION_DAYS=90
NOTIFICATIONS_FANOUT_BATCH_SIZE=500
NOTIFICATIONS_UNREAD_MESSAGE_EMAIL_DELAY_MINUTES=30
NOTIFICATIONS_DIGEST_HOUR=8
