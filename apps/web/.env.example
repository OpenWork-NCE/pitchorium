# Web app (apps/web). Copy to .env: Next.js reads it for `next dev`, `next build` and `next start`.
# Every variable is validated by src/lib/env.ts; `next build` fails on an invalid value.
# NEXT_PUBLIC_ variables are inlined in the browser bundle at build time: never put a secret there.

# Port of `pnpm dev` and `pnpm --filter @pitchorium/web start` (3000 is the default of the api).
WEB_PORT=3200

# Public origin of the web app: canonical URLs, sitemap, share images. HTTPS in production also
# enables HSTS and upgrade-insecure-requests.
NEXT_PUBLIC_SITE_URL=http://localhost:3200

# Public origin of the api, called by the browser with the session cookie (same parent domain as
# the web app in production, see AUTH_COOKIE_DOMAIN of the api). Must list the web origin in its
# CORS_ORIGINS and WEB_APP_URL.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Origin of the api seen by the Next.js server (private network of the hosting). Empty: the
# public origin above.
API_INTERNAL_URL=

# Public base URL of the files (S3_PUBLIC_BASE_URL of the api): allowed for images and media.
NEXT_PUBLIC_CDN_URL=http://localhost:9000/pitchorium-public

# Endpoint of the object storage the browser sends files to (S3_ENDPOINT of the api, reachable
# from the browser; R2: https://<account>.r2.cloudflarestorage.com): allowed by the CSP.
NEXT_PUBLIC_UPLOAD_URL=http://localhost:9000

# Sentry: active only with a DSN. The environment tags the events.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# Build only: source maps are uploaded when the token is set (CI of a deployment).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Published texts of the terms of use and the privacy policy (question 31), linked from the
# onboarding and the settings. Empty: the versions are shown without a link.
NEXT_PUBLIC_LEGAL_TERMS_URL=
NEXT_PUBLIC_LEGAL_PRIVACY_URL=

# Vercel Analytics and Speed Insights (true on a Vercel deployment only).
NEXT_PUBLIC_VERCEL_ANALYTICS=false
